-- ------------------------------- Monitor slot teleport (generik)
local function brSlots(box, n, tag)
    local slots = {}
    for i = 1, n do
        local idx = i
        local btn = box:CreateButton({ Name = "-", Callback = function()
            local s = slots[idx]
            local h = getHRP()
            if s.target and s.target.Parent and s.pos and h then
                local ok, err = pcall(function()
                    tpTo(h, CFrame.new(s.pos + Vector3.new(0, TUNE.tpLift, 0)))
                end)
                if ok then
                    logPush("tp ke " .. tostring(s.name))
                else
                    notify(tag, "TP gagal: " .. tostring(err):sub(1, 60))
                end
            else
                notify(tag, "Target sudah hilang.")
            end
        end })
        btn:SetVisible(false)
        slots[i] = { btn = btn, target = nil, pos = nil, name = "-" }
    end
    return slots
end

