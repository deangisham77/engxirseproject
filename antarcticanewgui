-- IMPORTANT: never WaitForChild() at top level. A missing/renamed folder would
-- block for up to 30s and the executor looks like it "cannot run".
-- These are resolved lazily and cached, with a background retry.
local _wcache = {}
local _get = function(nm)
    local v = _wcache[nm]
    if v == nil then
        v = workspace:FindFirstChild(nm)
        if v then _wcache[nm] = v end
    end
    return v
end
-- Accessors: selalu ambil ulang dari cache (folder bisa muncul belakangan).
-- Folder diambil lewat getSG()/getDG()/getBD()/getPR()/getDR() agar tidak ada
-- variabel lokal basi saat loop berjalan.
local function getSG() return _get("SpawnedGems") end
local function getDG() return _get("DroppedGems") end
local function getBD() return _get("Boulders") end
local function getPR() return _get("PlotRunes") end
local function getDR() return _get("DroppedRunes") end

-- background resolver: ambil folder begitu muncul, tanpa memblokir startup
task.spawn(function()
    for _ = 1, 60 do
        local missing = false
        for _, nm in ipairs({ "SpawnedGems", "DroppedGems", "Boulders", "PlotRunes", "DroppedRunes" }) do
            if _wcache[nm] == nil then
                local f = workspace:FindFirstChild(nm)
                if f then _wcache[nm] = f else missing = true end
            end
        end
        if not missing then break end
        task.wait(1)
    end
end)

