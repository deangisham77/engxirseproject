function createButton(parent, o, ctx)
    local btn = new("TextButton", {
        Name = "Btn_" .. tostring(o.Name or "Button"),
        Text = "",
        BackgroundColor3 = Theme.row,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, ctx.rowH),
        ZIndex = 9,
    }, parent)
    corner(btn, 7)
    local st = stroke(btn, Theme.stroke, 1, 0.35)

    local textX = 6
    local iconBox
    if o.Icon then
        iconBox = new("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 0),
            Size = UDim2.fromOffset(14, ctx.rowH),
            ZIndex = 10,
        }, btn)
        local ic = drawIcon(iconBox, o.Icon, 13, Theme.text, 10)
        ic.Position = UDim2.fromScale(0.5, 0.5)
        textX = 30
    end
    local text = label(btn, {
        Text = tostring(o.Name or "Button"),
        Font = FONT_BOLD,
        TextSize = 11,
        TextColor3 = Theme.text,
        TextXAlignment = o.Icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
        Position = UDim2.fromOffset(textX, 0),
        Size = UDim2.new(1, -(textX + 6), 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 10,
    })
    if o.Tooltip then
        attachTip(btn, o.Tooltip)
    end

    local api = {}
    local armed = false

    local function fire()
        if o.Callback then
            task.spawn(function()
                pcall(o.Callback)
            end)
        end
    end

    local function disarm()
        armed = false
        text.Text = tostring(api._name or o.Name or "Button")
        tween(btn, 0.12, { BackgroundColor3 = Theme.row })
        st.Color = Theme.stroke
    end

    btn.MouseEnter:Connect(function()
        if not armed then
            tween(btn, 0.12, { BackgroundTransparency = 0 })
            st.Color = Theme.accent
        end
    end)
    btn.MouseLeave:Connect(function()
        if not armed then
            tween(btn, 0.12, { BackgroundTransparency = 0.15 })
            st.Color = Theme.stroke
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if o.Confirm and not armed then
            armed = true
            text.Text = "Klik lagi untuk konfirmasi"
            btn.BackgroundColor3 = Theme.warn
            btn.BackgroundTransparency = 0.72
            st.Color = Theme.warn
            task.delay(3.2, function()
                if armed then
                    disarm()
                end
            end)
            return
        end
        if armed then
            disarm()
        end
        fire()
    end)

    api._name = tostring(o.Name or "Button")
    api._kind = "button"

    function api:SetText(t)
        api._name = tostring(t)
        if not armed then
            text.Text = tostring(t)
        end
    end
    function api:SetVisible(v)
        btn.Visible = v and true or false
    end
    function api:SetEnabled(v)
        btn.Active = v and true or false
        text.TextTransparency = (v == false) and 0.45 or 0
        if iconBox then
            iconBox.Visible = v ~= false
        end
    end
    function api:Click()
        fire()
    end
    function api:Get()
        return api._name
    end

    return api
end

