--============================================================================
-- STATS (untuk halaman Home)
--============================================================================
local startedAt = os.clock()
local fpsValue = 60
task.spawn(function()
    local frames, acc = 0, 0
    while true do
        local ok, dt = pcall(function()
            return RunService.RenderStepped:Wait()
        end)
        if not ok then
            break
        end
        acc += dt
        frames += 1
        if acc >= 0.5 then
            fpsValue = math.floor(frames / acc + 0.5)
            frames, acc = 0, 0
        end
    end
end)
local function pingMs()
    local ok, v = pcall(function()
        return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    return ok and (tostring(v) .. " ms") or "-"
end
local function memMb()
    local ok, v = pcall(function()
        return math.floor(game:GetService("Stats"):GetTotalMemoryUsageMb())
    end)
    return ok and (tostring(v) .. " MB") or "-"
end
local function executorName()
    local ok, name = pcall(function()
        return identifyexecutor and identifyexecutor() or "Unknown"
    end)
    if ok and type(name) == "string" then
        return name
    end
    return "Unknown"
end
local function uptimeText()
    local s = math.floor(os.clock() - startedAt)
    return string.format("%02d:%02d:%02d", math.floor(s / 3600), math.floor(s % 3600 / 60), s % 60)
end
local function statValue(key)
    local k = tostring(key)
    if k == "FPS" then
        return tostring(fpsValue)
    elseif k == "Ping" then
        return pingMs()
    elseif k == "Executor" then
        return executorName()
    elseif k == "Game" then
        local ok, n = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
        end)
        return (ok and n) or ("PlaceId " .. tostring(game.PlaceId))
    elseif k == "Players" then
        return tostring(#Players:GetPlayers()) .. "/" .. tostring(Players.MaxPlayers)
    elseif k == "Uptime" then
        return uptimeText()
    elseif k == "Memory" then
        return memMb()
    end
    return "-"
end

