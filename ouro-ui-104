    local function selectTab(tab)
        if not tab then
            return
        end
        Lib.ActiveTab = tab
        for _, t in ipairs(Lib.Tabs) do
            local active = (t == tab)
            t.Page.Visible = active
            if t.Row then
                tween(t.Row, 0.14, {
                    BackgroundTransparency = active and 0.82 or 1,
                })
                tween(t.Label, 0.14, {
                    TextColor3 = active and Theme.text or Theme.sub,
                })
                t.IconBox.Visible = active
            end
        end
        pageTitle.Text = tab.Header or tab.Name
        pageDesc.Text = tab.Desc or ""
    end
    window.SelectTab = function(_, name)
        for _, t in ipairs(Lib.Tabs) do
            if t.Name == name then
                selectTab(t)
                return
            end
        end
    end

