-- TOGGLE
--============================================================================
function createToggle(parent, o, ctx)
    local row = baseRow(parent, ctx.rowH)
    nameLabel(row, o.Name or "Toggle", 54)
    attachTip(row, o.Tooltip)

    local pill = new("Frame", {
        BackgroundColor3 = Theme.row,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(34, 18),
        ZIndex = 9,
    }, row)
    corner(pill, 9)
    local knob = new("Frame", {
        BackgroundColor3 = Theme.sub,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(12, 12),
        ZIndex = 10,
    }, pill)
    corner(knob, 999)

    local state = (o.CurrentValue == true) or (o.Default == true)
    local render

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 11,
    }, row)

    local api = {}
    render = function(animate)
        local onPos = UDim2.fromOffset(19, 3)
        local offPos = UDim2.fromOffset(3, 3)
        local pillColor = state and Theme.accent or shade(Theme.row, 1.25)
        local knobColor = state and Color3.new(1, 1, 1) or Theme.sub
        if animate then
            tween(knob, 0.16, { Position = state and onPos or offPos, BackgroundColor3 = knobColor })
            tween(pill, 0.16, { BackgroundColor3 = pillColor })
        else
            knob.Position = state and onPos or offPos
            knob.BackgroundColor3 = knobColor
            pill.BackgroundColor3 = pillColor
        end
    end
    render(false)
    table.insert(Lib.AccentRefresh, function()
        render(false)
    end)

    local function fire()
        if o.Callback then
            task.spawn(function()
                pcall(o.Callback, state)
            end)
        end
    end

    function api:Get()
        return state
    end
    function api:Set(value, silent)
        local v = value and true or false
        if v == state then
            if not silent then
                render(true)
            end
            return
        end
        state = v
        render(true)
        if not silent then
            fire()
        end
    end
    function api:Toggle()
        self:Set(not state)
    end
    api._kind = "toggle"

    hit.MouseButton1Click:Connect(function()
        api:Set(not state)
    end)

    registerFlag(o.Flag, api)
    if o.Flag then
        Lib.Flags[o.Flag] = api
    end
    return api
end

