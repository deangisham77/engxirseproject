    }, ctx)

    createLabel(body, {
        Text = "Config disimpan per-Flag (toggle, slider, dropdown, keybind, input). "
            .. "Tombol muat juga menjalankan callback agar fitur langsung aktif.",
    }, ctx)

    return {
        _kind = "config",
        Frame = card,
        Save = function(self)
            if Lib.Window then
                Lib.Window:SaveConfig(currentName())
            end
        end,
        Load = function(self)
            if Lib.Window then
                Lib.Window:LoadConfig(currentName())
            end
        end,
        Input = nameInput,
        _ = list,
    }
end

--============================================================================
-- THEME MANAGER
--============================================================================
function createThemeManager(parent)
    local card, body = panel(parent, "Theme", "settings")
    local ctx = widgetCtx()

    local grid = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 8,
    }, body)
    new("UIGridLayout", {
        CellSize = UDim2.new(0.5, -3, 0, 28),
        CellPadding = UDim2.fromOffset(6, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirectionMaxCells = 2,
    }, grid)

    local selected = 1
    local buttons = {}

    local function paint()
        applyAccent(ACCENTS[selected].a, ACCENTS[selected].b)
        for i, b in ipairs(buttons) do
            local on = (i == selected)
            b.Frame.BackgroundTransparency = on and 0 or 0.55
            b.Label.TextColor3 = on and Color3.new(1, 1, 1) or Theme.sub
            b.Dot.BackgroundColor3 = ACCENTS[i].b
        end
        for _, fn in ipairs(Lib.AccentRefresh) do
            pcall(fn)
        end
    end

    for i, preset in ipairs(ACCENTS) do
        local cell = new("Frame", {
            BackgroundColor3 = preset.a,
            BackgroundTransparency = i == 1 and 0 or 0.55,
            BorderSizePixel = 0,
            LayoutOrder = i,
            Size = UDim2.new(0, 0, 0, 28),
            ZIndex = 9,
        }, grid)
        corner(cell, 6)
        local dot = new("Frame", {
            BackgroundColor3 = preset.b,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.fromOffset(10, 10),
            ZIndex = 10,
        }, cell)
        corner(dot, 999)
        local lbl = label(cell, {
            Text = preset.name,
            Font = FONT_BOLD,
            TextSize = 10,
            TextColor3 = i == 1 and Color3.new(1, 1, 1) or Theme.sub,
            Position = UDim2.fromOffset(24, 0),
            Size = UDim2.new(1, -28, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 10,
        })
        local hit = new("TextButton", {
            Text = "",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            ZIndex = 11,
        }, cell)
        hit.MouseButton1Click:Connect(function()
            selected = i
            paint()
        end)
        buttons[i] = { Frame = cell, Label = lbl, Dot = dot }
    end

    createDivider(body, {}, ctx)

    createButton(body, {
        Name = "Reset ke Violet",
        Icon = "refresh",
        Callback = function()
            selected = 1
            paint()
        end,
    }, ctx)

    createLabel(body, {
        Text = "Tema hanya mengubah aksen; permukaan tetap gelap agar kontras teks stabil.",
    }, ctx)

    return {
        _kind = "theme",
        Frame = card,
        Set = function(self, idx)
            idx = math.clamp(tonumber(idx) or 1, 1, #ACCENTS)
            selected = idx
            paint()
        end,
        Get = function(self)
            return selected, ACCENTS[selected].name
        end,
    }
end

--============================================================================
-- API ekstra di level library
--============================================================================
function Ouro:Notify(o)
    notify(o)
end

function Ouro:SetAccent(index)
    local idx = math.clamp(tonumber(index) or 1, 1, #ACCENTS)
    applyAccent(ACCENTS[idx].a, ACCENTS[idx].b)
    for _, fn in ipairs(Lib.AccentRefresh) do
        pcall(fn)
    end
    return ACCENTS[idx].name
end

function Ouro:GetWindow()
    return Lib.Window
end

