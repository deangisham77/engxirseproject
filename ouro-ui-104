    end
    tipBox = new("TextLabel", {
        Name = "OuroTooltip",
        BackgroundColor3 = Theme.popup,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Font = FONT,
        TextSize = 11,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Visible = false,
        ZIndex = 500,
        Size = UDim2.fromOffset(180, 26),
        AutomaticSize = Enum.AutomaticSize.Y,
        AnchorPoint = Vector2.new(0.5, 1),
    }, Lib.Gui)
    corner(tipBox, 6)
    stroke(tipBox, Theme.stroke, 1, 0.2)
    pad(tipBox, 6, 8, 6, 8)
    return tipBox
end

local function attachTip(target, text)
    if not text or text == "" then
        return
    end
    local showTask
    target.MouseEnter:Connect(function()
        if not Lib.Tooltips then
            return
        end
        showTask = task.delay(0.28, function()
            local tip = ensureTip()
            if not tip then
                return
            end
            local pos = UserInputService:GetMouseLocation()
            tip.Text = tostring(text)
            tip.Position = UDim2.fromOffset(pos.X, pos.Y - 14)
            tip.Size = UDim2.fromOffset(180, 0)
            tip.Visible = true
        end)
    end)
    target.MouseLeave:Connect(function()
        if showTask then
            pcall(task.cancel, showTask)
            showTask = nil
        end
        if tipBox then
            tipBox.Visible = false
        end
    end)
end

