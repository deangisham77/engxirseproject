local function new(class, props, parent)
    local inst = Instance.new(class)
    if class == "TextButton" then
        inst.AutoButtonColor = false
    end
    for k, v in pairs(props or {}) do
        if v ~= nil then
            -- satu properti yang ditolak Roblox tidak boleh membunuh seluruh UI
            -- (kalau ditolak, cukup dicatat lewat warn lalu lanjut)
            local ok = pcall(function()
                inst[k] = v
            end)
            if not ok then
                warn("[Ouro UI] properti ditolak: " .. tostring(class) .. "." .. tostring(k))
            end
        end
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(inst, r)
    local c = new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, inst)
    return c
end

local function stroke(inst, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Theme.stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function pad(inst, t, r, b, l)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
    }, inst)
end

local function listLayout(inst, gap, dir)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = dir or Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }, inst)
end

local function tween(inst, time, props, style, dir)
    local ok, tw = pcall(function()
        local t = TweenService:Create(inst, TweenInfo.new(
            time or 0.14,
            style or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out
        ), props)
        t:Play()
        return t
    end)
    return ok and tw or nil
end

local function label(parent, props)
    local defaults = {
        BackgroundTransparency = 1,
        Font = FONT,
        TextSize = 12,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        RichText = false,
    }
    for k, v in pairs(props or {}) do
        defaults[k] = v
    end
    return new("TextLabel", defaults, parent)
end

local function shade(color, factor)
    local h, s, v = Color3.toHSV(color)
    return Color3.fromHSV(h, s, math.clamp(v * factor, 0, 1))
end

-- drag helper (dipakai topbar)
local function makeDraggable(handle, target, clampTo)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - dragStart
        local pos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        if clampTo then
            local vp = clampTo.AbsoluteSize
            local sz = target.AbsoluteSize
            local ax, ay = pos.X.Offset, pos.Y.Offset
            ax = math.clamp(ax, -sz.X + 80, vp.X - 80)
            ay = math.clamp(ay, 0, math.max(0, vp.Y - 44))
            pos = UDim2.new(0, ax, 0, ay)
        end
        target.Position = pos
    end)
end

