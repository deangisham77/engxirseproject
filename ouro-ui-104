        return type(writefile) == "function"
            and type(readfile) == "function"
            and type(isfile) == "function"
    end
    local function cfgPath(name)
        return cfgFolder .. "/" .. tostring(name or cfgFile) .. ".json"
    end
    local function ensureFolder()
        pcall(function()
            if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(cfgFolder) then
                makefolder(cfgFolder)
            end
        end)
    end

    local function collectFlags()
        local out = {}
        for _, flag in ipairs(Lib.FlagOrder) do
            local w = Lib.Flags[flag]
            if w and w.Get then
                local ok, v = pcall(function()
                    return w:Get()
                end)
                if ok and v ~= nil then
                    out[flag] = v
                end
            end
        end
        return out
    end

    function window.SaveConfig(_, name)
        if not fsReady() then
            notify({ Title = "Config", Content = "Executor tidak mendukung writefile.", Duration = 4 })
            return false
        end
        ensureFolder()
        local ok, encoded = pcall(function()
            return HttpService:JSONEncode(collectFlags())
        end)
        if not ok then
            return false
        end
        local wrote = pcall(writefile, cfgPath(name), encoded)
        notify({
            Title = "Config",
            Content = wrote and ("disimpan: " .. tostring(name or cfgFile)) or "gagal menyimpan.",
            Duration = 3,
        })
        return wrote
    end
    window.Save = window.SaveConfig

    function window.LoadConfig(_, name, quiet)
        if not fsReady() then
            return false
        end
        local path = cfgPath(name)
        local okFile, exists = pcall(isfile, path)
        if not okFile or not exists then
            return false
        end
        local okRead, txt = pcall(readfile, path)
        if not okRead or type(txt) ~= "string" or txt == "" then
            return false
        end
        local okDecode, data = pcall(function()
            return HttpService:JSONDecode(txt)
        end)
        if not okDecode or type(data) ~= "table" then
            return false
        end
        local applied = 0
        for flag, value in pairs(data) do
            local w = Lib.Flags[flag]
            if w and w.Set then
                local okSet = pcall(function()
                    w:Set(value)
                end)
                if okSet then
                    applied += 1
                end
            end
        end
        if not quiet then
            notify({ Title = "Config", Content = "dimuat: " .. tostring(applied) .. " setelan", Duration = 3 })
        end
        return true
    end

    function window.LoadAutoload(_)
        if not cfgEnabled then
            return false
        end
        return window:LoadConfig(cfgFile, true)
    end

    -- ------------------------------------------------------------------- API
    function window.CreateTab(_, o2)
        local t = makeTab(o2)
        if not Lib.ActiveTab then
            selectTab(t)
        end
        return t.Api
    end

    function window.Notify(_, o2)
        notify(o2)
    end

    function window.SetUIScale(_, scale)
        local v = math.clamp(tonumber(scale) or 1, 0.5, 1.5)
        Lib.UIScale = v
        pcall(function()
            uiScale.Scale = v
        end)
        return v
    end

    function window.Toggle(_, force)
        local nextState
        if force == nil then
            nextState = not gui.Enabled
        else
            nextState = force and true or false
        end
        gui.Enabled = nextState
        return nextState
    end

    local toggleKey = nil
    function window.Destroy(_)
        Lib.Alive = false
        for _, c in ipairs(Lib.Connections) do
            pcall(function()
                c:Disconnect()
            end)
        end
        Lib.Connections = {}
        Lib.Flags = {}
        Lib.FlagOrder = {}
        Lib.Tabs = {}
        Lib.Statuses = {}
        Lib.AccentRefresh = {}
        Lib.ActiveTab = nil
        pcall(function()
            gui:Destroy()
        end)
        if Lib.Window == window then
            Lib.Window = nil
            Lib.Gui = nil
            Lib.Root = nil
        end
    end

    -- --------------------------------------------------------- toggle keybind
    if opts.ToggleUIKeybind then
        toggleKey = opts.ToggleUIKeybind
    end
    keepConn(UserInputService.InputBegan:Connect(function(input, processed)
        if not toggleKey then
            return
        end
        local name = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
        if name ~= tostring(toggleKey) then
            return
        end
        local focused = nil
        pcall(function()
            focused = UserInputService:GetFocusedTextBox()
        end)
        if focused then
            return
        end
        window:Toggle()
    end))
    window.SetToggleKeybind = function(_, key)
        toggleKey = key
    end

    -- --------------------------------------------------------------- minimize
    -- Waktu minimize, jendela mengecil jadi bar tipis. Dua lapis bayangan di
    -- belakang jendela (shadow1 +26px, shadow2 +10px) HARUS ikut hilang, kalau
    -- tidak bar tipis itu berdiri di atas "plat" gelap besar -> kelihatan tidak
    -- menyatu. Jadi saat minimize bayangan disembunyikan total, dan ukurannya
    -- juga dipaksa kecil supaya tidak ada sisa plat saat transisi.
    local minimized = false
    local function applyMinimize(state)
        minimized = state
        content.Visible = not state
        sidebar.Visible = not state
        pcall(function()
            popupLayer.Visible = not state
            topLine.Visible = not state
        end)
        local barH = state and topH or winH
        tween(container, 0.18, { Size = UDim2.fromOffset(winW, barH) }, Enum.EasingStyle.Quint)
        -- ukuran bayangan: saat minimize dibikin rapat (bar + 8 / + 4), saat
        -- normal kembali ke halo lebar
        local pad1 = state and 8 or 26
        local pad2 = state and 4 or 10
        tween(shadow1, 0.18, { Size = UDim2.fromOffset(winW + pad1, barH + pad1) }, Enum.EasingStyle.Quint)
        tween(shadow2, 0.18, { Size = UDim2.fromOffset(winW + pad2, barH + pad2) }, Enum.EasingStyle.Quint)
        -- kunci utama: sembunyikan bayangan saat minimize (deterministik, tidak
        -- bergantung pada tween yang mungkin diabaikan executor tertentu)
        shadow1.Visible = not state
        shadow2.Visible = not state
        if minBtn.Icon and minBtn.AltIcon then
            minBtn.Icon.Visible = not state
            minBtn.AltIcon.Visible = state
        end
        -- jaring pengaman kalau tween tidak jalan: paksa ukuran setelah 0.3s
        task.delay(0.3, function()
            if minimized ~= state then
                return
            end
            pcall(function()
                if shadow1 and shadow1.Parent then
                    shadow1.Size = UDim2.fromOffset(winW + pad1, barH + pad1)
                end
                if shadow2 and shadow2.Parent then
                    shadow2.Size = UDim2.fromOffset(winW + pad2, barH + pad2)
                end
                if container and container.Parent then
                    container.Size = UDim2.fromOffset(winW, barH)
                end
            end)
        end)
    end
    minBtn.Hit.MouseButton1Click:Connect(function()
        applyMinimize(not minimized)
    end)
    closeBtn.Hit.MouseButton1Click:Connect(function()
        window:Toggle(false)
        notify({ Title = "UI disembunyikan", Content = "Tekan " .. tostring(toggleKey or "RightShift") .. " untuk membuka lagi.", Duration = 3 })
    end)

    -- ------------------------------------------------------------ splash fade
    -- Penghilang splash sudah didaftarkan di atas (tepat setelah splash dibuat),
    -- jadi error di bagian mana pun tidak bisa lagi membuat splash mentok.

    -- pilih tab pertama (Home kalau ada, kalau tidak tab API pertama)
    if not Lib.ActiveTab and #Lib.Tabs > 0 then
        selectTab(Lib.Tabs[1])
    end

    return window
end

--============================================================================
-- PENANGKAP ERROR + ENTRY POINT
-- Kalau CreateWindow gagal, errornya ditampilkan di layar (bukan cuma di
-- console) supaya bisa langsung dilaporkan / diketahui penyebabnya.
--============================================================================
local function reportError(msg)
    msg = tostring(msg or "error tidak diketahui")
    Ouro.LastError = msg
    pcall(function()
        if type(getgenv) == "function" then
            getgenv().OURO_LAST_ERROR = msg
        end
    end)
    warn("[Ouro UI] " .. msg)

    local gui = Lib.Gui
    if not (gui and gui.Parent) then
        local okNew, made = pcall(function()
            local s = Instance.new("ScreenGui")
            s.Name = "OuroError"
            s.ResetOnSpawn = false
            s.IgnoreGuiInset = true
            s.DisplayOrder = 999
            local okP = pcall(function()
                s.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
            end)
            if not okP then
                pcall(function()
                    s.Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
                end)
            end
            return s
        end)
        if okNew then
            gui = made
        end
    end
    if not (gui and gui.Parent) then
        return
    end

    pcall(function()
        local old = gui:FindFirstChild("OuroErrorCard")
        if old then
            old:Destroy()
        end
        local card = new("Frame", {
            Name = "OuroErrorCard",
            BackgroundColor3 = Theme.card,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(580, 300),
            ZIndex = 3000,
        }, gui)
        corner(card, 12)
        stroke(card, Theme.bad, 1, 0)
        label(card, {
            Text = "Ouro UI error - screenshot teks ini",
            Font = FONT_BOLD,
            TextSize = 13,
            TextColor3 = Theme.bad,
            Position = UDim2.fromOffset(14, 10),
            Size = UDim2.new(1, -28, 0, 16),
            ZIndex = 3001,
        })
        local box = new("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(14, 32),
            Size = UDim2.new(1, -28, 1, -46),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ScrollBarThickness = 3,
            ZIndex = 3001,
        }, card)
        local t = new("TextLabel", {
            BackgroundTransparency = 1,
            Font = FONT_MONO,
            TextSize = 11,
            TextColor3 = Theme.sub,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            Text = msg,
            Size = UDim2.new(1, -8, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 3002,
        }, box)
        t.Name = "OuroErrorText"
    end)
end
Ouro.ReportError = reportError

-- entry point publik: bungkus buildWindow supaya error apa pun tertangkap
function Ouro:CreateWindow(options)
    local ok, res = xpcall(buildWindow, function(err)
        local trace = ""
        pcall(function()
            trace = debug.traceback("", 2)
        end)
        return tostring(err) .. "\n\n" .. trace
    end, options)
    if ok then
        Ouro.LastError = nil
        return res
    end
    reportError(res)
    error("[Ouro UI] " .. tostring(res), 0)
end

