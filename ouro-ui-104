local function drawIcon(parent, name, size, color, zindex)
    local box = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        ClipsDescendants = true,
        ZIndex = zindex or 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Name = "Icon_" .. tostring(name),
    }, parent)
    local shapes = ICONS[name] or ICONS.info
    local c = color or Theme.sub
    for _, s in ipairs(shapes) do
        local kind = s.k
        if kind == "line" then
            local ln = new("Frame", {
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale((s.x or 0) + (s.w or 0) / 2, (s.y or 0) + (s.h or 0) / 2),
                Size = UDim2.fromScale(s.w or 0.5, s.h or 0.1),
                Rotation = s.rot or 0,
                ZIndex = zindex or 1,
            }, box)
            corner(ln, 2)
        elseif kind == "diamond" then
            local d = new("Frame", {
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale((s.x or 0) + (s.w or 0) / 2, (s.y or 0) + (s.h or 0) / 2),
                Size = UDim2.fromScale(s.w or 0.5, s.h or s.w or 0.5),
                Rotation = 45,
                ZIndex = zindex or 1,
            }, box)
            corner(d, s.r or 2)
        elseif kind == "circle" then
            local ci = new("Frame", {
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale((s.x or 0) + (s.w or 0) / 2, (s.y or 0) + (s.h or s.w or 0) / 2),
                Size = UDim2.fromScale(s.w or 0.4, s.h or s.w or 0.4),
                ZIndex = zindex or 1,
            }, box)
            corner(ci, 999)
        elseif kind == "ring" then
            local rg = new("Frame", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale((s.x or 0) + (s.w or 0) / 2, (s.y or 0) + (s.h or 0) / 2),
                Size = UDim2.fromScale(s.w or 0.8, s.h or s.w or 0.8),
                ZIndex = zindex or 1,
            }, box)
            corner(rg, 999)
            new("UIStroke", {
                Color = c,
                Thickness = math.max(1.5, size * 0.085),
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            }, rg)
        else
            local rc = new("Frame", {
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale((s.x or 0) + (s.w or 0) / 2, (s.y or 0) + (s.h or 0) / 2),
                Size = UDim2.fromScale(s.w or 0.6, s.h or 0.6),
                ZIndex = zindex or 1,
            }, box)
            corner(rc, s.r or 2)
        end
    end
    return box
end

