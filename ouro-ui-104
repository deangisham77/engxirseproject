function createKeybind(parent, o, ctx)
    local row = baseRow(parent, ctx.rowH)
    nameLabel(row, o.Name or "Keybind", 90)
    attachTip(row, o.Tooltip)

    local pill = new("Frame", {
        BackgroundColor3 = shade(Theme.row, 1.3),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(72, 20),
        ZIndex = 9,
    }, row)
    corner(pill, 6)
    local keyLabel = label(pill, {
        Text = tostring(o.Default or "-"),
        Font = FONT_BOLD,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 10,
    })

    local key = tostring(o.Default or "-")
    local listening = false
    local api = { _kind = "keybind" }

    local function showKey()
        keyLabel.Text = (key == "-") and "kosong" or key
        keyLabel.TextColor3 = (key == "-") and Theme.dim or Theme.text
    end

    local function activate()
        if o.Callback then
            task.spawn(function()
                pcall(o.Callback, key)
            end)
        end
    end

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 11,
    }, row)
    hit.MouseButton1Click:Connect(function()
        listening = not listening
        keyLabel.Text = listening and "tekan..." or ((key == "-") and "kosong" or key)
        pill.BackgroundColor3 = listening and Theme.accent or shade(Theme.row, 1.3)
    end)

    local conn = UserInputService.InputBegan:Connect(function(input, processed)
        local name = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
        if listening then
            if input.KeyCode == Enum.KeyCode.Escape then
                listening = false
                showKey()
                pill.BackgroundColor3 = shade(Theme.row, 1.3)
                return
            end
            listening = false
            key = name
            showKey()
            pill.BackgroundColor3 = shade(Theme.row, 1.3)
            if o.OnChanged then
                task.spawn(function()
                    pcall(o.OnChanged, key)
                end)
            end
            return
        end
        if not key or key == "-" then
            return
        end
        if name ~= key then
            return
        end
        local focused = nil
        pcall(function()
            focused = UserInputService:GetFocusedTextBox()
        end)
        if focused then
            return
        end
        activate()
    end)
    keepConn(conn)

    function api:Get()
        return key
    end
    function api:Set(v, silent)
        key = tostring(v or "-")
        showKey()
        if not silent and o.OnChanged then
            task.spawn(function()
                pcall(o.OnChanged, key)
            end)
        end
    end

    showKey()
    registerFlag(o.Flag, api)
    return api
end

