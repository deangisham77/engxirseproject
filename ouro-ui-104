-- instance aksen yang ikut berubah saat tema diganti
local accentLinks = {}
local function linkAccent(inst, prop, slot)
    table.insert(accentLinks, { inst = inst, prop = prop, slot = slot or "accent" })
    inst[prop] = (slot == "accent2") and Theme.accent2 or Theme.accent
    return inst
end
local function applyAccent(a, b)
    Theme.accent, Theme.accent2 = a, b
    for _, l in ipairs(accentLinks) do
        pcall(function()
            l.inst[l.prop] = (l.slot == "accent2") and Theme.accent2 or Theme.accent
        end)
    end
end
Ouro.ApplyAccent = applyAccent

