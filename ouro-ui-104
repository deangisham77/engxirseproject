--============================================================================
function createSlider(parent, o, ctx)
    local range = o.Range or { 0, 100 }
    local minV = tonumber(range[1]) or 0
    local maxV = tonumber(range[2]) or 100
    if maxV <= minV then
        maxV = minV + 1
    end
    local inc = tonumber(o.Increment) or 1
    local suffix = tostring(o.Suffix or "")

    local h = ctx.rowH + 16
    local row = baseRow(parent, h)
    nameLabel(row, o.Name or "Slider", 90).Size = UDim2.new(1, -90, 0, 18)
    local valueLabel = label(row, {
        Text = "",
        Font = FONT_BOLD,
        TextSize = 11,
        TextColor3 = Theme.accent2,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(1, -80, 0, 0),
        Size = UDim2.fromOffset(74, 18),
        ZIndex = 9,
    })

    local track = new("Frame", {
        BackgroundColor3 = shade(Theme.row, 1.3),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 6, 0, h - 16),
        Size = UDim2.new(1, -12, 0, 4),
        ZIndex = 9,
    }, row)
    corner(track, 2)
    local fill = new("Frame", {
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = 10,
    }, track)
    corner(fill, 2)
    new("UIGradient", { Color = ColorSequence.new(Theme.accent, Theme.accent2) }, fill)
    table.insert(Lib.AccentRefresh, function()
        fill.BackgroundColor3 = Theme.accent
        valueLabel.TextColor3 = Theme.accent2
    end)
    local knob = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        ZIndex = 11,
    }, track)
    corner(knob, 999)
    stroke(knob, Theme.accent, 2, 0)

    local value = tonumber(o.CurrentValue) or minV
    local api = {}

    local function fmt(v)
        local n = (inc >= 1) and math.floor(v + 0.5) or v
        if inc >= 1 then
            return string.format("%d%s", n, suffix)
        end
        return string.format("%.1f%s", n, suffix)
    end

    local function render()
        local frac = (value - minV) / (maxV - minV)
        frac = math.clamp(frac, 0, 1)
        fill.Size = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, 0, 0.5, 0)
        valueLabel.Text = fmt(value)
    end

    local function fire()
        if o.Callback then
            task.spawn(function()
                pcall(o.Callback, value)
            end)
        end
    end

    function api:Get()
        return value
    end
    function api:Set(v, silent)
        local n = tonumber(v) or minV
        n = math.clamp(n, minV, maxV)
        if inc > 0 then
            n = minV + math.floor((n - minV) / inc + 0.5) * inc
        end
        value = math.clamp(n, minV, maxV)
        render()
        if not silent then
            fire()
        end
    end
    api._kind = "slider"

    local dragging = false
    local function pointerValue()
        local mx = UserInputService:GetMouseLocation().X
        local ax = track.AbsolutePosition.X
        local aw = math.max(track.AbsoluteSize.X, 1)
        local frac = math.clamp((mx - ax) / aw, 0, 1)
        return minV + frac * (maxV - minV)
    end

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, h - 24),
        Size = UDim2.new(1, 0, 0, 24),
        ZIndex = 12,
    }, row)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            api:Set(pointerValue())
        end
    end)
    keepConn(UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            api:Set(pointerValue())
        end
    end))
    keepConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    render()
    registerFlag(o.Flag, api)
    return api
end

--============================================================================
-- DROPDOWN
--============================================================================
function createDropdown(parent, o, ctx)
    local row = baseRow(parent, ctx.rowH)
    nameLabel(row, o.Name or "Option", 132)
    attachTip(row, o.Tooltip)

    local multi = o.Multi == true
    local options = {}
    for _, v in ipairs(o.Options or {}) do
        table.insert(options, tostring(v))
    end

    local selected
    if multi then
        selected = {}
        local def = o.Default or o.CurrentOption
        if type(def) == "table" then
            for _, v in ipairs(def) do
                selected[tostring(v)] = true
            end
        elseif type(def) == "string" and def ~= "" then
            selected[def] = true
        end
    else
        selected = nil
        local cur = o.CurrentOption
        if type(cur) == "table" then
            cur = cur[1]
        end
        if type(cur) == "string" then
            selected = cur
        elseif #options > 0 then
            selected = options[1]
        end
    end

    local valueLabel = label(row, {
        Text = "",
        TextSize = 11,
        TextColor3 = Theme.sub,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(1, -112, 0, 0),
        Size = UDim2.fromOffset(88, ctx.rowH),
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 9,
    })
    local chev = new("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        ZIndex = 9,
    }, row)
    drawIcon(chev, "chevron-down", 11, Theme.dim, 9)

    local api = {}
    local popup, blocker

    local function selectedList()
        local out = {}
        if multi then
            for _, v in ipairs(options) do
                if selected[v] then
                    table.insert(out, v)
                end
            end
        elseif selected then
            table.insert(out, selected)
        end
        return out
    end

    local function display()
        local list = selectedList()
        if multi then
            if #list == 0 then
                valueLabel.Text = "tidak ada"
            elseif #list == #options then
                valueLabel.Text = "semua (" .. tostring(#list) .. ")"
            else
                valueLabel.Text = table.concat(list, ", ")
            end
        else
            valueLabel.Text = list[1] or "-"
        end
    end

    local function fire()
        local payload
        if multi then
            payload = selectedList()
        else
            payload = selected
        end
        if o.Callback then
            task.spawn(function()
                pcall(o.Callback, payload)
            end)
        end
    end

    local function close(silent)
        if blocker then
            blocker:Destroy()
            blocker = nil
        end
        if popup then
            local p = popup
            popup = nil
            tween(p, 0.1, { BackgroundTransparency = 1 })
            task.delay(0.12, function()
                if p then
                    p:Destroy()
                end
            end)
        end
        if not silent then
            fire()
        end
    end

    local function open()
        if popup or not ctx.window or not ctx.window.PopupLayer then
            return
        end
        local layer = ctx.window.PopupLayer
        local root = ctx.window.Root
        local relX = row.AbsolutePosition.X - root.AbsolutePosition.X
        local relY = row.AbsolutePosition.Y - root.AbsolutePosition.Y + row.AbsoluteSize.Y + 4
        local w = row.AbsoluteSize.X
        local boxH = math.min(220, 10 + #options * 26 + (o.Searchable and 32 or 0))

        -- jaga popup tetap di dalam jendela (container clip)
        local rootW = (root.AbsoluteSize and root.AbsoluteSize.X) or 0
        local rootH = (root.AbsoluteSize and root.AbsoluteSize.Y) or 0
        if rootW > 0 and relX + w > rootW - 8 then
            relX = math.max(8, rootW - 8 - w)
        end
        if rootH > 0 and relY + boxH > rootH - 8 then
            relY = math.max(8, relY - row.AbsoluteSize.Y - boxH - 8)
        end

        blocker = new("TextButton", {
            Text = "",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            ZIndex = 55,
        }, layer)
        blocker.MouseButton1Click:Connect(function()
            close()
        end)

        popup = new("Frame", {
            BackgroundColor3 = Theme.popup,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(relX, relY),
            Size = UDim2.fromOffset(w, boxH),
            ClipsDescendants = true,
            ZIndex = 56,
        }, layer)
        corner(popup, 8)
        stroke(popup, Theme.stroke, 1, 0.1)

        local scroll = new("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, o.Searchable and 34 or 0),
            Size = UDim2.new(1, 0, 1, -(o.Searchable and 34 or 0)),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.stroke,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ZIndex = 57,
        }, popup)
        listLayout(scroll, 2).HorizontalAlignment = Enum.HorizontalAlignment.Left
        pad(scroll, 6, 6, 6, 6)

        if o.Searchable then
            local sbox = new("Frame", {
                BackgroundColor3 = Theme.row,
                BorderSizePixel = 0,
                Position = UDim2.fromOffset(6, 6),
                Size = UDim2.new(1, -12, 0, 24),
                ZIndex = 58,
            }, popup)
            corner(sbox, 6)
            local sinput = new("TextBox", {
                BackgroundTransparency = 1,
                Font = FONT,
                TextSize = 11,
                TextColor3 = Theme.text,
                PlaceholderText = "cari...",
                PlaceholderColor3 = Theme.dim,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -16, 1, 0),
                ZIndex = 59,
            }, sbox)
            sinput:GetPropertyChangedSignal("Text"):Connect(function()
                local q = string.lower(sinput.Text)
                for _, optRow in ipairs(scroll:GetChildren()) do
                    if optRow:IsA("TextButton") then
                        local txt = string.lower(optRow:GetAttribute("OuroOption") or "")
                        optRow.Visible = (q == "" or string.find(txt, q, 1, true) ~= nil)
                    end
                end
            end)
        end

        for idx, opt in ipairs(options) do
            local isOn = multi and selected[opt] or (not multi and selected == opt)
            local item = new("TextButton", {
                Text = "",
                BackgroundColor3 = Theme.row,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 24),
                ZIndex = 58,
            }, scroll)
            item:SetAttribute("OuroOption", opt)
            corner(item, 5)
            label(item, {
                Text = opt,
                TextSize = 11,
                TextColor3 = isOn and Theme.text or Theme.sub,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -28, 1, 0),
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 59,
            })
            if isOn then
                local chk = new("Frame", {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -6, 0.5, 0),
                    Size = UDim2.fromOffset(11, 11),
                    ZIndex = 59,
                }, item)
                drawIcon(chk, "check", 10, Theme.accent2, 59)
            end
            item.MouseEnter:Connect(function()
                tween(item, 0.1, { BackgroundTransparency = 0.85 })
            end)
            item.MouseLeave:Connect(function()
                tween(item, 0.1, { BackgroundTransparency = 1 })
            end)
            item.MouseButton1Click:Connect(function()
                if multi then
                    selected[opt] = (not selected[opt]) or nil
                    display()
                    close(true)
                    open()
                else
                    selected = opt
                    display()
                    close()
                end
            end)
            item.LayoutOrder = idx
        end
        tween(popup, 0.1, { BackgroundTransparency = 0 })
    end

    local hit = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 12,
    }, row)
    hit.MouseButton1Click:Connect(function()
        if popup then
            close()
        else
            open()
        end
    end)

    function api:Get()
        if multi then
            return selectedList()
        end
        return selected
    end
    function api:Set(v, silent)
        if multi then
            selected = {}
            if type(v) == "table" then
                for _, x in ipairs(v) do
                    selected[tostring(x)] = true
                end
            elseif type(v) == "string" then
                selected[v] = true
            end
        else
            if type(v) == "table" then
                v = v[1]
            end
            selected = v and tostring(v) or nil
        end
        display()
        if not silent then
            fire()
        end
    end
    function api:SetOptions(list)
        options = {}
        for _, v in ipairs(list or {}) do

            table.insert(options, tostring(v))
        end
        if multi then
            local keep = {}
            for _, v in ipairs(options) do
                if selected[v] then
                    keep[v] = true
                end
            end
            selected = keep
        elseif selected and not table.find(options, selected) then
            selected = options[1]
        elseif not selected then
            selected = options[1]
        end
        display()
        if popup then
            close(true)
            open()
        end
    end
    api._kind = "dropdown"

    display()
    registerFlag(o.Flag, api)
    return api
end

