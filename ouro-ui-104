    local manual = false
    local api = { _kind = "status" }
    function api:Set(text)
        manual = true
        valueLabel.Text = tostring(text)
    end
    function api:Clear()
        manual = false
    end

    if o.Update then
        local rate = tonumber(o.UpdateRate) or 0.5
        if rate < 0.1 then
            rate = 0.1
        end
        table.insert(Lib.Statuses, api)
        task.spawn(function()
            while Lib.Alive and Lib.Window == ctx.window do
                if not manual then
                    local ok, v = pcall(o.Update)
                    if ok and v ~= nil then
                        valueLabel.Text = tostring(v)
                    end
                end
                task.wait(rate)
            end
        end)
    end

    return api
end

