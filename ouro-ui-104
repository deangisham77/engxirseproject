function createLog(parent, o, ctx)
    local maxRows = tonumber(o.MaxRows) or 6
    local maxEntries = tonumber(o.MaxEntries) or 80
    local holder = new("Frame", {
        BackgroundColor3 = Theme.row,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, maxRows * 14 + 14),
        ZIndex = 8,
    }, parent)
    corner(holder, 7)
    local empty = label(holder, {
        Text = tostring(o.EmptyText or "belum ada log"),
        TextSize = 10,
        TextColor3 = Theme.dim,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 9,
    })
    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 6),
        Size = UDim2.new(1, -16, 1, -12),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.stroke,
        ScrollBarImageTransparency = 0.4,
        ZIndex = 9,
    }, holder)
    local content = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 10,
    }, scroll)
    listLayout(content, 2)

    local entries = {}
    local api = { _kind = "log", MaxEntries = maxEntries }

    local function bottom()
        task.defer(function()
            pcall(function()
                scroll.CanvasSize = UDim2.new(0, 0, 0, content.AbsoluteSize.Y)
                scroll.CanvasPosition = Vector2.new(0, math.max(0, content.AbsoluteSize.Y - scroll.AbsoluteSize.Y))
            end)
        end)
    end

    function api:Push(text)
        empty.Visible = false
        local line = label(content, {
            Text = tostring(text),
            Font = FONT_MONO,
            TextSize = 10,
            TextColor3 = Theme.sub,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 12),
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 11,
        })
        table.insert(entries, line)
        while #entries > maxEntries do
            local old = table.remove(entries, 1)
            if old then
                old:Destroy()
            end
        end
        bottom()
    end

    function api:Clear()
        for _, line in ipairs(entries) do
            pcall(function()
                line:Destroy()
            end)
        end
        entries = {}
        empty.Visible = true
        bottom()
    end

    return api
end

